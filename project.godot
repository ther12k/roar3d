; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Roarball"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

driver/enable_input=true

[autoload]

AppRouter="*res://scripts/app/app_router.gd"
ProgressStore="*res://scripts/app/progress_store.gd"
SettingsStore="*res://scripts/app/settings_store.gd"
AudioDirector="*res://scripts/app/audio_director.gd"
QualityDirector="*res://scripts/app/quality_director.gd"

[internationalization]
locale/translations=PackedStringArray("res://assets/locale/strings.en.translation", "res://assets/locale/strings.id.translation")

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[layer_names]

3d_physics/1="Ball"
3d_physics/2="Course"
3d_physics/3="MovingObstacle"
3d_physics/4="GameplayTrigger"
3d_physics/5="CameraBlocker"

[physics]

3d/default_gravity=9.8
3d/physics_engine="JoltPhysics3D"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
